# Only names/defaults; this file contains no credentials. setup_local.py creates
# the private database/edge/worker/operator values in .env. Never replace them.
PINET_GOOGLE_API_KEY=
PINET_LIVEKIT_URL=
PINET_LIVEKIT_API_KEY=
PINET_LIVEKIT_API_SECRET=
PINET_CORE_URL=http://127.0.0.1:8840
PINET_VOICE_ENABLED=false
PINET_M0_VERIFIED=false
PINET_M0_PROBE_ENABLED=false
PINET_ALLOW_SIMULATION=true
PINET_GLOBAL_DAILY_BUDGET_MICROUSD=0
PINET_VOICE_COST_CEILING_MICROUSD=0
PINET_ANALYSIS_COST_CEILING_MICROUSD=0
PINET_SMTP_ENABLED=false
PINET_SMTP_USER=
PINET_SMTP_PASSWORD=
# Optional Jev credentials remain private. Per-site operator toggle defaults OFF.
# These caps apply to one API process, not a durable daily/global budget.
PINET_JEV_API_KEY=
PINET_JEV_BUDGET_MICROUSD=150000
PINET_JEV_MAX_CALLS=50
PINET_JEV_TIMEOUT_SECONDS=1.5
