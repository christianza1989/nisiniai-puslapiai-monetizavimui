            "title": "Version",
            "type": "string"
          },
          "creation_id": {
            "format": "uuid",
            "title": "Creation Id",
            "type": "string"
          },
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "config_revision": {
            "maximum": 2147483647,
            "minimum": 1,
            "title": "Config Revision",
            "type": "integer"
          },
          "config_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Config Sha256",
            "type": "string"
          },
          "max_calls": {
            "maximum": 10,
            "minimum": 3,
            "title": "Max Calls",
            "type": "integer"
          },
          "reserved_calls": {
            "maximum": 10,
            "minimum": 0,
            "title": "Reserved Calls",
            "type": "integer"
          },
          "settled_calls": {
            "maximum": 10,
            "minimum": 0,
            "title": "Settled Calls",
            "type": "integer"
          },
          "usage_complete": {
            "title": "Usage Complete",
            "type": "boolean"
          },
          "scenario": {
            "enum": [
              "owner_scenario",
              "saved_example"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "model": {
            "const": "gpt-6.1-sol",
            "title": "Model",
            "type": "string"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "const": "high",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Effort"
          },
          "execution_profile_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Profile Sha256"
          },
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Conversation Id"
          },
          "quality_job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quality Job Id"
          },
          "calibration_status": {
            "const": "UNVERIFIED",
            "default": "UNVERIFIED",
            "title": "Calibration Status",
            "type": "string"
          },
          "module_admission": {
            "const": "not_admitted",
            "default": "not_admitted",
            "title": "Module Admission",
            "type": "string"
          },
          "activation": {
            "const": "not_performed",
            "default": "not_performed",
            "title": "Activation",
            "type": "string"
          }
        },
        "required": [
          "creation_id",
          "agent_id",
          "config_revision",
          "config_sha256",
          "max_calls",
          "reserved_calls",
          "settled_calls",
          "usage_complete",
          "scenario",
          "model",
          "reasoning_effort",
          "execution_profile_sha256"
        ],
        "title": "EpisodeView",
        "type": "object"
      },
      "PublicEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "topic_id": {
            "format": "uuid",
            "title": "Topic Id",
            "type": "string"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "sequence": {
            "maximum": 2147483647,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "author_type": {
            "enum": [
              "user",
              "coordinator",
              "adviser"
            ],
            "title": "Author Type",
            "type": "string"
          },
          "author_user_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author User Id"
          },
          "participant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Id"
          },
          "attempt_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "native_episode_task_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Native Episode Task Id"
          },
          "kind": {
            "enum": [
              "owner_message",
              "assignment",
              "answer"
            ],
            "title": "Kind",
            "type": "string"
          },
          "reply_to_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To Event Id"
          },
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "content_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Sha256",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Revision",
            "type": "string"
