  "components": {
    "schemas": {
      "Capability": {
        "properties": {
          "creation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Creation Id"
          },
          "admission_id": {
            "type": "string",
            "format": "uuid",
            "title": "Admission Id"
          },
          "transport": {
            "type": "string",
            "const": "customer-text.v1",
            "title": "Transport"
          },
          "model": {
            "type": "string",
            "const": "gpt-6-luna",
            "title": "Model"
          },
          "scope": {
            "type": "string",
            "const": "local_authenticated_test",
            "title": "Scope"
          },
          "can_start_text_session": {
            "type": "boolean",
            "const": true,
            "title": "Can Start Text Session"
          },
          "can_call_provider": {
            "type": "boolean",
            "const": true,
            "title": "Can Call Provider"
          },
          "consent_required": {
            "type": "boolean",
            "const": true,
            "title": "Consent Required"
          },
          "notice_version": {
            "type": "string",
            "const": "customer-text.local.v1",
            "title": "Notice Version"
          },
          "need_fields": {
            "items": {
              "type": "string",
              "enum": [
                "goal",
                "requirements",
                "deadline",
                "budget",
                "location"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Need Fields"
          },
          "channel_activation": {
            "type": "string",
            "const": "not_performed",
            "title": "Channel Activation"
          },
          "calibration_status": {
            "type": "string",
            "const": "UNVERIFIED",
            "title": "Calibration Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "creation_id",
          "admission_id",
          "transport",
          "model",
          "scope",
          "can_start_text_session",
          "can_call_provider",
          "consent_required",
          "notice_version",
          "need_fields",
          "channel_activation",
          "calibration_status"
        ],
        "title": "Capability"
      },
      "CapabilityEnvelope": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "customer-text.v1",
            "title": "Contract Version"
          },
          "environment": {
            "type": "string",
