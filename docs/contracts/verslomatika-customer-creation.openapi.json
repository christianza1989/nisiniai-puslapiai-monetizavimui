  "components": {
    "securitySchemes": {
      "CoreSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "Start": {
        "additionalProperties": false,
        "properties": {
          "portfolio_id": {
            "format": "uuid",
            "title": "Portfolio Id",
            "type": "string"
          },
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "idea": {
            "maxLength": 2500,
            "minLength": 20,
            "title": "Idea",
            "type": "string"
          },
          "canonical_host": {
            "anyOf": [
              {
                "maxLength": 253,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Host"
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "portfolio_id",
          "display_name",
          "idea",
          "canonical_host",
          "idempotency_key"
        ],
        "title": "Start",
        "type": "object"
      },
      "Revise": {
        "additionalProperties": false,
        "properties": {
          "base_revision": {
            "maximum": 20,
            "minimum": 0,
            "title": "Base Revision",
            "type": "integer"
          },
          "message": {
            "maxLength": 2500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "base_revision",
          "message",
          "idempotency_key"
        ],
        "title": "Revise",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "can_revise": {
            "title": "Can Revise",
            "type": "boolean"
          },
          "can_cancel": {
            "title": "Can Cancel",
            "type": "boolean"
          }
        },
        "required": [
          "can_revise",
          "can_cancel"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "CreationView": {
        "additionalProperties": false,
        "properties": {
          "creation_id": {
            "format": "uuid",
            "title": "Creation Id",
            "type": "string"
          },
          "portfolio_id": {
            "format": "uuid",
            "title": "Portfolio Id",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "idea": {
            "title": "Idea",
            "type": "string"
          },
          "canonical_host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Host"
          },
          "status": {
            "enum": [
