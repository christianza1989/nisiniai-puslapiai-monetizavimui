{
  "$defs": {
    "KnowledgeRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "knowledge_revision": {
          "minimum": 1,
          "title": "Knowledge Revision",
          "type": "integer"
        },
        "knowledge_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Knowledge Hash",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
        }
      },
      "required": [
        "knowledge_revision",
        "knowledge_hash",
        "deployment_id"
      ],
      "title": "KnowledgeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "organization_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "business_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Business Id",
      "type": "string"
    },
    "environment_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "site_id": {
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "title": "Site Id",
      "type": "string"
    },
    "registration_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Registration Id",
      "type": "string"
    },
    "admission_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Admission Id",
      "type": "string"
    },
    "accepted_revision": {
      "minimum": 1,
      "title": "Accepted Revision",
      "type": "integer"
    },
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "accepted_source_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Accepted Source Revision",
      "type": "string"
    },
    "execution_source_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Execution Source Revision",
      "type": "string"
    },
    "instruction_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Instruction Sha256",
      "type": "string"
    },
    "knowledge_ref": {
      "$ref": "#/$defs/KnowledgeRef"
    },
    "index_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Index Receipt Sha256",
      "type": "string"
    },
    "facts_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Facts Sha256",
      "type": "string"
    },
    "expires_at": {
      "exclusiveMinimum": 0,
      "title": "Expires At",
      "type": "number"
    },
    "profile_current": {
      "title": "Profile Current",
      "type": "boolean"
    },
    "module_admitted": {
      "title": "Module Admitted",
      "type": "boolean"
    }
  },
  "required": [
    "organization_id",
    "business_id",
    "environment_id",
    "site_id",
    "registration_id",
    "admission_id",
    "accepted_revision",
    "candidate_sha256",
    "accepted_source_revision",
    "execution_source_revision",
    "instruction_sha256",
    "knowledge_ref",
    "index_receipt_sha256",
    "facts_sha256",
    "expires_at",
    "profile_current",
    "module_admitted"
  ],
  "title": "Binding",
  "type": "object"
}
