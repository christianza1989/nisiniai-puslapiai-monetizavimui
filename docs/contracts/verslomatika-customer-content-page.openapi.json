            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "canonicalHost": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "brand": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accent"
