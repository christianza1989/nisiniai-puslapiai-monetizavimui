          "event_id",
          "topic_id",
          "task_id",
          "sequence",
          "author_type",
          "author_user_id",
          "participant_id",
          "attempt_id",
          "kind",
          "reply_to_event_id",
          "content",
          "content_sha256",
          "source_revision",
          "created_at"
