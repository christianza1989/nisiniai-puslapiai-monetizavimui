    "/operator/v2/tasks/{task_id}/events": {
      "get": {
        "operationId": "readTaskEvents",
        "security": [
          {
            "OperatorSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "after_sequence",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
