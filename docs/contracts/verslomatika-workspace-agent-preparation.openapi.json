{
  "openapi": "3.1.0",
  "info": {
    "title": "Explicit canonical agent draft preparation",
    "version": "workspace-agent-preparation.v1",
    "description": "One explicit owner preparation intent on the maintained team Task worker. Native Foundation and current authority required. Saving a description is not calibration, execution or activation."
  },
  "paths": {
    "/customer/v2/portfolios/{portfolio_id}/workspace-topics/{topic_id}/team/agent-preparations": {
      "post": {
        "security": [
          {
            "CustomerSession": []
          }
        ],
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareAgent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native owner receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreparationEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Invalid/denied/conflicting/limited/unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "additionalProperties": false,
        "properties": {
          "turn": {
            "$ref": "#/components/schemas/Turn"
          },
          "event": {
            "$ref": "#/components/schemas/PublicEvent"
          }
        },
        "required": [
          "turn",
          "event"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "ContextReceipt": {
        "additionalProperties": false,
        "properties": {
          "context_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Context Sha256",
            "type": "string"
          },
          "roster_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Roster Sha256",
            "type": "string"
          },
          "history_cutoff": {
            "maximum": 2147483647,
            "minimum": 1,
            "title": "History Cutoff",
            "type": "integer"
          },
          "history_event_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 20,
            "title": "History Event Ids",
            "type": "array"
          },
          "omitted_history_events": {
            "minimum": 0,
            "title": "Omitted History Events",
            "type": "integer"
          },
          "reply_to_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To Event Id"
          }
        },
        "required": [
          "context_sha256",
          "roster_sha256",
          "history_cutoff",
          "history_event_ids",
          "omitted_history_events",
          "reply_to_event_id"
        ],
        "title": "ContextReceipt",
        "type": "object"
      },
      "EpisodeView": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": "workspace-agent-episode.v1",
