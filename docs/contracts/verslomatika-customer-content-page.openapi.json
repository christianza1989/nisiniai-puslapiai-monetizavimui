                  },
                  "phone": {
                    "type": "string"
                  }
                }
              },
              "renderer": {
                "enum": [
                  "gift",
                  "niche"
                ]
              },
              "operatorName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      },
