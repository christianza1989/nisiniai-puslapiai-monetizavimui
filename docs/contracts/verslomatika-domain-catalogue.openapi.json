                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screening Evaluated At"
          },
          "top200": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopSelection"
              },
              {
                "type": "null"
              }
            ]
          },
          "category_label": {
            "maxLength": 180,
            "title": "Category Label",
            "type": "string"
          },
          "risk_label": {
            "maxLength": 180,
            "title": "Risk Label",
            "type": "string"
          },
          "availability": {
            "const": "unknown",
            "title": "Availability",
            "type": "string"
          },
          "availability_checked_at": {
            "title": "Availability Checked At",
            "type": "null"
          }
        },
        "required": [
          "domain",
          "category",
          "classification_source",
          "category_evidence",
          "niche",
          "keyword",
          "risk",
          "source_index",
          "queue_rank",
          "queue_score",
          "screening_rank",
          "screening_score",
          "screening_evaluated_at",
          "top200",
          "category_label",
          "risk_label",
          "availability",
          "availability_checked_at"
