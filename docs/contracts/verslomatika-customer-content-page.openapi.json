          },
          "contentVersion": {
            "const": 2
          },
          "editorial": {
            "$ref": "#/components/schemas/Native_editorial"
          },
          "siteSnapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "canonicalHost",
              "locale",
              "timezone",
              "brand",
              "offer",
              "contact",
              "renderer",
              "operatorName"
