{
  "openapi": "3.1.0",
  "info": {
    "title": "Verslomatika allowlisted public business projects",
    "version": "0.1.0",
    "description": "LOCAL development/testing only; default OFF. No external email/deployment/AI execution. Separately allowlisted revision-approved records only, due publication and immediate revoke. Operational proof expires to unknown/stale. No private IDs/grants/chat/tasks/finance/leads. List is bounded100 entries; filters/search can apply to the complete published local inventory. All replies no-store; source errors are distinct from an empty list."
  },
  "paths": {
    "/public/v1/projects": {
      "get": {
        "operationId": "listPublicProjects",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Committed safe projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials/session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local feature disabled or no current ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No scoped/public object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Changed idempotency input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Durable action limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/v1/projects/{slug}": {
      "get": {
        "operationId": "getPublicProject",
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed safe projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials/session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local feature disabled or no current ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No scoped/public object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Changed idempotency input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Durable action limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CoreSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "Automation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "planned",
              "testing",
              "verified",
              "paused",
              "unknown",
              "stale"
            ]
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "status",
          "checked_at",
          "expires_at"
        ]
      },
      "Image": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string",
            "maxLength": 1024
          },
          "alt": {
            "type": "string",
            "maxLength": 240
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "credit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "src",
          "alt",
          "width",
          "height",
          "credit",
          "checked_at"
        ]
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "canonical_host": {
            "type": "string",
            "maxLength": 253
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relationship": {
            "enum": [
              "own_project",
              "permitted_client_case"
            ]
          },
          "website_stage": {
            "enum": [
              "registered",
              "published",
              "unavailable",
              "unverified"
            ]
          },
          "automation_stage": {
            "enum": [
              "planned",
              "testing",
              "installed",
              "verified",
              "paused",
              "unknown",
              "stale"
            ]
          },
          "public_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "public_automations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Automation"
            }
          },
          "evidence_urls": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ]
          },
          "publication_approved": {
            "const": true
          },
          "approved_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "slug",
          "display_name",
          "canonical_host",
          "sector",
          "relationship",
          "website_stage",
          "automation_stage",
          "public_summary",
          "public_automations",
          "evidence_urls",
          "checked_at",
          "published_at",
          "updated_at",
          "image",
          "publication_approved",
          "approved_revision"
        ]
      },
      "Projects": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "items",
          "snapshot_id"
        ]
      },
      "ProjectsEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "public_portfolio.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Projects"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "ProjectEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "public_portfolio.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Project"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      }
    }
  }
}
