  "components": {
    "schemas": {
      "Anchor": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "portfolio",
              "discovery",
              "creation",
              "business"
            ],
            "title": "Kind",
            "type": "string"
          },
          "selection_id": {
            "format": "uuid",
            "title": "Selection Id",
