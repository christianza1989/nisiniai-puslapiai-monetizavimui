  "components": {
    "securitySchemes": {
      "OperatorSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "MessageInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "message",
          "idempotency_key"
        ]
      },
      "Answer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "limitations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "answer",
          "limitations"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "const": "chat.consult"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Answer"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "runner_unavailable",
                  "model_unavailable",
                  "provider_error",
                  "output_invalid",
                  "run_timeout",
                  "authorization_revoked",
                  "worker_interrupted",
                  "tool_attempted"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "task_id",
          "thread_id",
          "business_id",
          "sequence",
          "kind",
          "status",
          "message",
          "created_at",
          "updated_at",
          "result",
          "failure_code"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "thread_id",
          "business_id",
          "task"
        ]
      },
      "Thread": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "tasks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        },
        "required": [
          "thread_id",
          "business_id",
          "created_at",
          "tasks"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "runner_unavailable",
                  "model_unavailable",
                  "provider_error",
                  "output_invalid",
                  "run_timeout",
                  "authorization_revoked",
                  "worker_interrupted",
                  "tool_attempted"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sequence",
          "task_id",
          "status",
          "created_at",
          "failure_code"
        ]
      },
      "Events": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "next_sequence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "task_id",
          "items",
          "next_sequence"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "AcceptedEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "chat.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Accepted"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "ThreadEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "chat.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Thread"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "TaskEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "chat.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "EventsEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "chat.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Events"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      }
    }
  }
}
