{
  "openapi": "3.1.0",
  "info": {
    "title": "Native editorial review and atomic approval",
    "version": "editorial-review.v1",
    "description": "Current authenticated owner/Session/S6/accepted candidate/source/host and idle Creation/GUIDE. Explicit revision-bound six-area evidence only; reviewer/actor comes from the real server user. Canonical model writers preserve fact/media/source/link/current-review/atomic-batch gates. Immutable operation receipts support exact replay; ambiguous dispatched writes fail closed. No generic commands, preparation authority expansion, fact clearing, independent release, deployment, model calls or invented review/PASS. Full-site and launch stay UNVERIFIED."
  },
  "paths": {
    "/customer/v2/creations/{creation_id}/editorial-reviews": {
      "post": {
        "operationId": "recordCustomerEditorialReview",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "parameters": [
          {
            "name": "creation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-unknown-query-parameters": "rejected",
        "x-body-byte-limit": 131072,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordReview"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed safe result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditorialResultEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Safe refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
