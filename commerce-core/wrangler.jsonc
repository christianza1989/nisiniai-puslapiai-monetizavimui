{
  "name": "pinet-commerce-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-11",
  "vars": {
    "COMMERCE_ENV": "sandbox",
  },
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "commerce-local-only",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
