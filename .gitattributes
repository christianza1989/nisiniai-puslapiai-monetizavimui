* text=auto
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.woff2 binary
# Quarantine payloads retain original bytes across Windows/Linux clones.
/core-improvements/entries/**/quarantine/source.txt -text
# Imported SOURCE archives retain their catalogued original bytes, including CRLF.
**/SOURCE_SKILL.md -text -filter -working-tree-encoding
**/SOURCE_PROMPT.md -text -filter -working-tree-encoding
