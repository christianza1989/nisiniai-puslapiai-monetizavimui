{
  "openapi": "3.1.0",
  "info": {
    "title": "Exact registered customer agent preparation",
    "version": "0.1.0",
    "description": "Additive read-only exact current verified customer/owner/session. Uses canonical creation-registration.v1 RegistrationView; only binding_current grants business-scoped observations. Missing/stale/revoked/grant-revoked/pending stays unmapped; final revoke discards prior runtime observations. Historical accepted source remains distinct from current execution envelope SHA; source_pin retains conservative current-source comparison. No host ownership inference, public source/profile/session admission, activation, provider, persistent SQL/file writes, mail/voice/acquisition/learning or calibration/F1/launch acceptance. Original V1 DTO/contract unchanged; the new route requires schema0016 before explicit portal adoption. Rollback portal reader to original V1 first."
  },
  "paths": {
    "/customer/v2/creations/{creation_id}/agent-preparation-v2": {
      "get": {
        "operationId": "getCustomerAgentPreparationV2",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "creation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "accepted_revision",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "description": "Optional exact current accepted revision; stale409, no revision truthful blocked200."
          }
        ],
        "responses": {
          "200": {
            "description": "Committed safe projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPreparationViewV2Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials/session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local feature disabled or no current ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No scoped/public object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Explicit revision stale or registration changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Durable action limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-unknown-query-parameters": "rejected",
        "x-duplicate-query-parameters": "rejected"
      }
    }
  },
