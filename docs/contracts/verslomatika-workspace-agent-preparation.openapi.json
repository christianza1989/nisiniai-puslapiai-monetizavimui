          },
          "creation_id": {
            "format": "uuid",
            "title": "Creation Id",
            "type": "string"
          },
          "purpose": {
            "enum": [
              "site_chat",
              "customer_research",
              "email",
              "custom"
            ],
            "title": "Purpose",
            "type": "string"
