        ],
        "title": "Anchor",
        "type": "object"
      },
      "History": {
        "additionalProperties": false,
        "properties": {
          "topic_id": {
            "format": "uuid",
            "title": "Topic Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "maxItems": 50,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "cutoff_sequence": {
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Cutoff Sequence",
            "type": "integer"
          }
        },
        "required": [
          "topic_id",
          "items",
          "next_cursor",
          "cutoff_sequence"
        ],
        "title": "History",
        "type": "object"
      },
      "MessageResult": {
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/ReceiptView"
          },
          "message": {
            "$ref": "#/components/schemas/MessageView"
          }
        },
        "required": [
          "receipt",
          "message"
        ],
        "title": "MessageResult",
        "type": "object"
      },
      "MessageView": {
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          },
          "topic_id": {
            "format": "uuid",
            "title": "Topic Id",
            "type": "string"
          },
          "sequence": {
            "maximum": 2147483647,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "author_type": {
            "const": "user",
            "title": "Author Type",
            "type": "string"
          },
          "author_user_id": {
            "format": "uuid",
            "title": "Author User Id",
            "type": "string"
          },
          "content": {
            "maxLength": 2500,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "content_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Sha256",
            "type": "string"
          },
          "stored_source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Stored Source Revision",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dispatch_state": {
            "const": "stored_without_dispatch",
            "title": "Dispatch State",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "topic_id",
          "sequence",
          "author_type",
          "author_user_id",
          "content",
          "content_sha256",
          "stored_source_revision",
          "created_at",
          "dispatch_state"
        ],
        "title": "MessageView",
        "type": "object"
      },
      "MetadataResult": {
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/ReceiptView"
          },
          "current_topic": {
            "$ref": "#/components/schemas/TopicView"
          }
        },
        "required": [
          "receipt",
          "current_topic"
        ],
        "title": "MetadataResult",
        "type": "object"
      },
      "MetadataSnapshot": {
        "additionalProperties": false,
        "properties": {
          "topic_id": {
            "format": "uuid",
            "title": "Topic Id",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "pinned": {
            "title": "Pinned",
            "type": "boolean"
          },
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "metadata_revision": {
            "maximum": 2147483647,
            "minimum": 1,
            "title": "Metadata Revision",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
