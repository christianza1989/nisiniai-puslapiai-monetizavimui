{
  "name": "ergonomic-lt",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check:seo": "tsx scripts/check-seo.ts && tsx scripts/check-editorial.ts",
    "content:export": "node --import tsx scripts/editorial/content.mjs export",
    "content:validate": "node --import tsx scripts/editorial/content.mjs validate",
    "content:compile": "node --import tsx scripts/editorial/content.mjs compile",
    "content:import": "node --import tsx scripts/editorial/content.mjs import",
    "content:diff": "node --import tsx scripts/editorial/content.mjs diff",
    "content:restore": "node --import tsx scripts/editorial/content.mjs restore",
    "check:editorial": "tsx scripts/check-editorial.ts",
    "setup:admin": "node scripts/setup-admin.mjs",
    "backup": "node scripts/backup.mjs",
    "dev:cloudflare": "node scripts/cloudflare.mjs dev",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "types:cloudflare": "node scripts/cloudflare.mjs types",
    "migrate:cloudflare": "wrangler d1 migrations apply ergonomic-preview --remote",
    "typecheck:cloudflare": "tsc -p tsconfig.cloudflare.json --noEmit",
    "check:cloudflare": "tsx scripts/check-cloudflare.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "^1.3.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-rsc": "^0.5.36",
    "assimpjs": "^0.0.10",
    "linkedom": "^0.18.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "type": "module"
}
