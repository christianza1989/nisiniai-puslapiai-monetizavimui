          },
          "topic_id": {
            "format": "uuid",
            "title": "Topic Id",
            "type": "string"
          },
          "sequence": {
            "maximum": 20,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "native_episode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EpisodeView"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "failure_code": {
            "anyOf": [
              {
                "pattern": "^[a-z_]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "reserved_calls": {
            "maximum": 10,
            "minimum": 0,
            "title": "Reserved Calls",
            "type": "integer"
          },
          "settled_calls": {
            "maximum": 10,
            "minimum": 0,
            "title": "Settled Calls",
            "type": "integer"
          },
          "usage_complete": {
            "title": "Usage Complete",
            "type": "boolean"
          },
          "cost_status": {
            "const": "UNVERIFIED",
            "title": "Cost Status",
            "type": "string"
          },
          "context_receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextReceipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
