  "components": {
    "securitySchemes": {
      "OperatorSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "const": "chat.consult"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Answer"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "runner_unavailable",
                  "model_unavailable",
                  "provider_error",
                  "output_invalid",
                  "run_timeout",
                  "authorization_revoked",
                  "worker_interrupted",
                  "tool_attempted"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "task_id",
          "thread_id",
          "business_id",
          "sequence",
          "kind",
          "status",
          "message",
          "created_at",
          "updated_at",
          "result",
          "failure_code"
        ]
      },
      "Answer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "limitations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "answer",
          "limitations"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "Agent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "const": "business-planner"
          },
          "display_name": {
            "type": "string"
          },
          "kind": {
            "const": "chat.consult"
          },
          "description": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "enum": [
                  "chat_unavailable",
                  "operator_required",
                  "runner_unavailable",
                  "runner_not_configured"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "const": "medium"
          },
          "tools": {
            "type": "array",
            "maxItems": 0
          },
          "system_writes": {
            "const": false
          },
          "worker_health": {
            "const": "unknown"
          },
          "daily_task_limit": {
            "type": "integer"
          }
        },
        "required": [
          "agent_id",
          "display_name",
          "kind",
          "description",
          "availability",
          "unavailable_reason",
          "model",
          "effort",
          "tools",
          "system_writes",
          "worker_health",
          "daily_task_limit"
        ]
      },
      "Agents": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        },
        "required": [
          "business_id",
          "items"
        ]
      },
      "TaskInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "const": "business-planner"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "agent_id",
          "message",
          "idempotency_key"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "agent_id": {
            "const": "business-planner"
          },
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "business_id",
          "agent_id",
          "thread_id",
          "task"
        ]
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_id": {
            "type": "string"
          }
        },
        "required": [
          "business_id",
          "items",
          "next_cursor",
          "snapshot_id"
        ]
      },
      "Overview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "queued": {
                "type": "integer",
                "minimum": 0
              },
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "succeeded": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "cancelled": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "last_task_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "agent": {
            "$ref": "#/components/schemas/Agent"
          }
        },
        "required": [
          "business_id",
          "task_counts",
          "last_task_at",
          "agent"
        ]
      },
      "Execution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "adapter_revision": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "propertyNames": {
                  "pattern": "_tokens$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_microusd": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "model",
          "effort",
          "adapter_revision",
          "started_at",
          "finished_at",
          "usage",
          "cost_microusd"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "const": "business-planner"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Execution"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_revision": {
            "type": "string"
          }
        },
        "required": [
          "agent_id",
          "task",
          "execution",
          "source_revision"
        ]
      },
      "AgentsEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "operations.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test",
              "production"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Agents"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "AcceptedEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "operations.v1"
          },
          "environment": {
            "enum": [
              "local",
              "test",
              "production"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Accepted"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ]
      },
      "HistoryEnvelope": {
        "type": "object",
        "additionalProperties": false,
