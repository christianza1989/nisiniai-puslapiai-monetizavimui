{
  "openapi": "3.1.0",
  "info": {
    "title": "Native local website Foundation observations",
    "version": "site-foundation.v1",
    "description": "Fixed canonical candidate/local verifier observations with immutable owner-bound receipts. Current accepted revision/source/evidence required for the private agent-draft precondition; no calibration, live channel, deployment or general runtime permission."
  },
  "paths": {
    "/customer/v2/creations/{creation_id}/foundation": {
      "get": {
        "security": [
          {
            "CustomerSession": []
          }
        ],
        "parameters": [
          {
            "name": "creation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/customer/v2/creations/{creation_id}/foundation/checks": {
      "post": {
        "security": [
          {
            "CustomerSession": []
          }
        ],
        "parameters": [
          {
            "name": "creation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Invalid, denied, conflicting or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Check"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Check": {
        "additionalProperties": false,
        "properties": {
          "accepted_revision": {
            "maximum": 20,
            "minimum": 1,
            "title": "Accepted Revision",
            "type": "integer"
          },
          "command": {
            "enum": [
              "candidate",
              "verify-local"
            ],
            "title": "Command",
            "type": "string"
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "accepted_revision",
          "command",
          "idempotency_key"
        ],
        "title": "Check",
        "type": "object"
      },
      "FoundationView": {
        "additionalProperties": false,
        "properties": {
          "creation_id": {
            "format": "uuid",
            "title": "Creation Id",
            "type": "string"
          },
          "current_revision": {
            "maximum": 20,
            "minimum": 0,
            "title": "Current Revision",
            "type": "integer"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "state": {
            "enum": [
              "missing",
              "blocked",
              "candidate",
              "verified-local",
              "stale",
              "unavailable"
            ],
            "title": "State",
            "type": "string"
          },
          "foundation_status": {
            "enum": [
              "UNVERIFIED",
              "LOCAL_DELIVERY_CHECKS_PASS"
            ],
            "title": "Foundation Status",
            "type": "string"
          },
          "agent_foundation_ready": {
            "title": "Agent Foundation Ready",
            "type": "boolean"
          },
          "can_check": {
            "title": "Can Check",
            "type": "boolean"
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReceiptView"
              },
              {
                "type": "null"
              }
            ]
          },
          "blockers": {
            "items": {
              "pattern": "^[a-z0-9_:-]{1,160}$",
              "type": "string"
            },
            "maxItems": 500,
            "title": "Blockers",
            "type": "array"
          },
          "calibration_status": {
            "const": "UNVERIFIED",
            "title": "Calibration Status",
            "type": "string"
          },
          "channel_activation": {
            "const": "not_performed",
            "title": "Channel Activation",
            "type": "string"
          },
          "deployment": {
            "const": "not_performed",
            "title": "Deployment",
            "type": "string"
          }
        },
        "required": [
          "creation_id",
          "current_revision",
          "observed_at",
          "state",
          "foundation_status",
          "agent_foundation_ready",
          "can_check",
          "latest",
          "blockers",
          "calibration_status",
          "channel_activation",
          "deployment"
        ],
        "title": "FoundationView",
        "type": "object"
      },
      "ReceiptView": {
        "additionalProperties": false,
        "properties": {
          "receipt_id": {
            "format": "uuid",
            "title": "Receipt Id",
            "type": "string"
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          },
          "command": {
            "enum": [
              "candidate",
              "verify-local"
            ],
            "title": "Command",
            "type": "string"
          },
          "creation_id": {
            "format": "uuid",
            "title": "Creation Id",
            "type": "string"
          },
          "accepted_revision": {
            "maximum": 20,
            "minimum": 1,
            "title": "Accepted Revision",
            "type": "integer"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "state": {
            "enum": [
              "blocked",
              "candidate",
              "verified-local"
            ],
            "title": "State",
            "type": "string"
          },
          "blockers": {
            "items": {
              "pattern": "^[a-z0-9_:-]{1,160}$",
              "type": "string"
            },
            "maxItems": 500,
            "title": "Blockers",
            "type": "array"
          },
          "release_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Id"
          },
          "package_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Sha256"
          },
          "execution_source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Execution Source Revision",
            "type": "string"
          },
          "public_source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Public Source Revision",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "calibration_status": {
            "const": "UNVERIFIED",
            "title": "Calibration Status",
            "type": "string"
          },
          "channel_activation": {
            "const": "not_performed",
            "title": "Channel Activation",
            "type": "string"
          },
          "deployment": {
            "const": "not_performed",
            "title": "Deployment",
            "type": "string"
          }
        },
        "required": [
          "receipt_id",
          "idempotency_key",
          "command",
          "creation_id",
          "accepted_revision",
          "checked_at",
          "state",
          "blockers",
          "release_id",
          "package_sha256",
          "execution_source_revision",
          "public_source_revision",
          "synthetic",
          "calibration_status",
          "channel_activation",
          "deployment"
        ],
        "title": "ReceiptView",
        "type": "object"
      },
      "Envelope": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "site-foundation.v1",
            "title": "Contract Version",
            "type": "string"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ],
            "title": "Environment",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Revision",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/FoundationView"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ],
        "title": "Envelope",
        "type": "object"
      },
      "ReceiptEnvelope": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "site-foundation.v1",
            "title": "Contract Version",
            "type": "string"
          },
          "environment": {
            "enum": [
              "local",
              "test"
            ],
            "title": "Environment",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Revision",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ReceiptView"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "source_revision",
          "observed_at",
          "request_id",
          "data"
        ],
        "title": "ReceiptEnvelope",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "request_id"
        ],
        "title": "Error",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CustomerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
