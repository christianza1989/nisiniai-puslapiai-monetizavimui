        "required": [
          "task_id",
          "topic_id",
          "sequence",
          "idempotency_key",
          "status",
          "created_at",
          "updated_at",
          "failure_code",
          "reserved_calls",
          "settled_calls",
          "usage_complete",
          "cost_status",
          "context_receipt",
          "started_at",
          "lease_until"
