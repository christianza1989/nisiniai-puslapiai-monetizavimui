  "components": {
    "securitySchemes": {
      "CoreSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "RegisterInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 256
          },
          "password_confirm": {
            "type": "string",
            "minLength": 15,
            "maxLength": 256
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "privacy_accepted": {
            "const": true
          }
        },
        "required": [
          "email",
          "password",
          "password_confirm",
          "display_name",
          "privacy_accepted"
        ]
      },
      "EmailInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "ResetInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 256
          },
          "password_confirm": {
            "type": "string",
            "minLength": 15,
            "maxLength": 256
          }
        },
        "required": [
          "token",
          "password",
          "password_confirm"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "accepted"
          },
          "delivery": {
            "const": "development_outbox"
          }
        },
        "required": [
          "status",
          "delivery"
        ]
      },
      "Verified": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "verified"
          },
          "next_action": {
            "const": "login"
          }
        },
        "required": [
          "status",
          "next_action"
        ]
      },
      "Reset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "password_reset"
          },
          "next_action": {
            "const": "login"
          }
        },
        "required": [
          "status",
          "next_action"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{64}$"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_at"
        ]
      },
      "Portfolio": {
        "type": "object",
