            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Revision",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Accepted"
          }
        },
        "required": [
          "contract_version",
          "environment",
          "request_id",
          "source_revision",
          "observed_at",
          "data"
        ],
        "title": "PreparationEnvelope",
        "type": "object"
      },
      "PrepareAgent": {
        "additionalProperties": false,
