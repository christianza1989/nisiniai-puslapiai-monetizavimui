{
  "openapi": "3.1.0",
  "info": {
    "title": "Verslomatika historical domain catalogue",
    "version": "0.1.0",
    "description": "domains.v1 LOCAL/TEST only. Same opaque core bearer session; verified customer or original operator required by parent adapter. Full historical45324 inventory, preserved9200 screening rows and frozenTOP200. No live availability/ownership/registrar purchase/DNS. Source ranks and inference are explicit; recommendations never promise demand or economics."
  },
  "paths": {
    "/customer/v2/domains": {
      "get": {
        "operationId": "searchCustomerDomains",
        "security": [
          {
            "CoreSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "construction",
                "home",
                "energy",
                "property",
                "auto",
                "finance",
                "legal",
                "business",
                "tech",
                "marketing",
                "health",
                "beauty",
                "sport",
                "food",
                "tourism",
                "events",
                "education",
                "jobs",
                "family",
                "pets",
                "agriculture",
                "industry",
                "logistics",
                "commerce",
                "fashion",
                "gifts",
                "electronics",
                "cleaning",
                "security",
                "entertainment",
                "media",
                "community",
                "adult",
                "gambling",
                "other",
                "unclear",
                "unclassified"
              ]
            }
          },
          {
            "in": "query",
            "name": "top200_only",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "source",
                "queue",
                "screening",
                "research_priority",
                "potential"
              ],
              "default": "research_priority"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical catalogue projection; availability and ownership unverified",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_SearchData_"
                }
              }
            }
          },
          "400": {
            "description": "Invalid bounded request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No current core session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local feature disabled or account not verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Action limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Pinned catalogue source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
