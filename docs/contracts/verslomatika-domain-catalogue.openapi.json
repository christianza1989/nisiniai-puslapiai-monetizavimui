      }
    }
  },
  "components": {
    "securitySchemes": {
      "CoreSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CatalogueMetadata": {
        "additionalProperties": false,
        "properties": {
          "snapshot_date": {
            "format": "date",
            "title": "Snapshot Date",
            "type": "string"
          },
          "inventory_count": {
            "maximum": 100000,
            "minimum": 1,
            "title": "Inventory Count",
            "type": "integer"
          },
          "screening_count": {
            "maximum": 100000,
            "minimum": 0,
            "title": "Screening Count",
            "type": "integer"
          },
          "top200_count": {
            "const": 200,
            "title": "Top200 Count",
            "type": "integer"
          },
          "top200_research_complete_count": {
            "maximum": 200,
            "minimum": 0,
            "title": "Top200 Research Complete Count",
            "type": "integer"
          },
          "top200_research_pending_count": {
            "maximum": 200,
            "minimum": 0,
            "title": "Top200 Research Pending Count",
            "type": "integer"
          },
          "source_documents": {
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            },
            "maxItems": 5,
            "minItems": 5,
            "title": "Source Documents",
            "type": "array"
          },
          "original_inventory_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Original Inventory Sha256",
            "type": "string"
          },
          "classification_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "source_ai_screening",
                "lexical_inference",
                "unclassified"
              ]
            },
            "title": "Classification Counts",
            "type": "object"
          },
          "screening_models": {
            "items": {
              "maxLength": 180,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Screening Models",
            "type": "array"
          },
          "screening_versions": {
            "items": {
              "maxLength": 180,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Screening Versions",
            "type": "array"
          },
          "taxonomy_version": {
            "const": "lexical-v1",
            "title": "Taxonomy Version",
            "type": "string"
          },
          "selection_created_at": {
            "format": "date-time",
            "title": "Selection Created At",
            "type": "string"
          },
          "selection_priority_updated_at": {
            "format": "date-time",
            "title": "Selection Priority Updated At",
            "type": "string"
          },
          "rank_comparison": {
            "$ref": "#/components/schemas/RankComparison"
          },
          "availability": {
            "const": "unknown",
            "title": "Availability",
            "type": "string"
          },
          "availability_checked_at": {
            "title": "Availability Checked At",
            "type": "null"
          },
          "notice": {
            "maxLength": 300,
            "title": "Notice",
            "type": "string"
          },
          "score_notice": {
            "maxLength": 300,
            "title": "Score Notice",
            "type": "string"
          },
          "catalogue_version": {
            "const": "domains.v1",
            "title": "Catalogue Version",
            "type": "string"
          },
          "snapshot_id": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": [
          "snapshot_date",
          "inventory_count",
          "screening_count",
          "top200_count",
          "top200_research_complete_count",
          "top200_research_pending_count",
          "source_documents",
          "original_inventory_sha256",
          "classification_counts",
          "screening_models",
          "screening_versions",
          "taxonomy_version",
          "selection_created_at",
          "selection_priority_updated_at",
          "rank_comparison",
          "availability",
          "availability_checked_at",
          "notice",
          "score_notice",
          "catalogue_version",
          "snapshot_id"
